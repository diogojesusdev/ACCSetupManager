{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ACC Setup Manager",
  "version": "0.1.0",
  "identifier": "com.accsetupmanager.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ACC Setup Manager",
        "width": 1240,
        "height": 820,
        "minWidth": 860,
        "minHeight": 620,
        "resizable": true,
        "visible": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "backgroundColor": "#0A0B0C"
      },
      {
        "label": "splashscreen",
        "title": "ACC Setup Manager",
        "url": "splashscreen.html",
        "width": 560,
        "height": 280,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "alwaysOnTop": true,
        "center": true,
        "backgroundColor": "#0A0B0C"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
